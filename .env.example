# Supabase — project region MUST be eu-central-1 (Frankfurt) for EU data residency.
# Create the project in an account the GYM OWNER controls, not a personal one.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: skip the Supabase connection and run the UI against an in-memory
# fixture. Useful for design work before the project exists.
# VITE_OFFLINE_FIXTURE=1

# Must equal Streamlit's USERNAME_DOMAIN: "dimitris" signs in as dimitris@<this>.
VITE_USERNAME_DOMAIN=powerhouse.gr

# The sign-in providers switched on in Supabase (Authentication → Providers).
# Leave one out until it is configured there, or its button leads to an error page.
VITE_AUTH_PROVIDERS=google,azure
# Store apps: add apple (App Review requires it beside Google): google,azure,apple

# The hosted site. Links the app hands out (invites, share links) are built from it. Required
# for the store apps, whose own origin is the phone (https://localhost); optional on the web.
# VITE_PUBLIC_ORIGIN=https://app.powerhouse.gr
