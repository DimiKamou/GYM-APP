# Streamlit secrets — the Supabase keys, including service_role, which bypasses
# every row-level security policy in the schema. Named file by file rather than
# ignoring .streamlit/ wholesale: config.toml in the same directory is what
# Streamlit Community Cloud reads for the theme, and it has to stay tracked.
.streamlit/secrets.toml
streamlit/.streamlit/secrets.toml
