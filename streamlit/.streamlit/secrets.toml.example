# Copy this file to `.streamlit/secrets.toml` next to it and replace the four
# values. That file is git-ignored and must stay that way: it is never committed,
# never pasted into an issue, and never sent over chat.
#
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# Every value below is a placeholder. None of them is a real key.

# Supabase -> Project Settings -> API -> Project URL.
# The same project the React PWA in src/ uses. A second project means a second,
# empty gym.
SUPABASE_URL = "https://PROJECT-REF-GOES-HERE.supabase.co"

# Supabase -> Project Settings -> API -> Project API keys -> anon / public.
# Public by design: every statement it sends is still evaluated by the row-level
# security policies, which is what protects the data.
SUPABASE_ANON_KEY = "PASTE-THE-ANON-KEY-HERE"

# Supabase -> Project Settings -> API -> Project API keys -> service_role.
# This one bypasses every policy in the schema. It is read only by lib/admin.py
# and used only to create an account in auth.users; it never touches a public
# table. Leave it out entirely and the app runs untouched — only "new user" on
# the Ομάδα screen is unavailable. lib/admin.py also accepts it under the name
# SUPABASE_SERVICE_KEY.
SUPABASE_SERVICE_ROLE_KEY = "PASTE-THE-SERVICE-ROLE-KEY-HERE"

# The synthetic mail domain that turns a username into an address Supabase Auth
# accepts: "maria" signs in as maria@<USERNAME_DOMAIN>. No mail is ever sent to
# it, so it does not have to exist — but it must never change once accounts have
# been created, because it is half of every one of their sign-ins.
USERNAME_DOMAIN = "gym.example"
